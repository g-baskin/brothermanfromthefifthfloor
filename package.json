{
  "name": "brah",
  "version": "0.1.0",
  "description": "A fresh Electron desktop app.",
  "main": "src/main.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env.local ./node_modules/electron/cli.js .",
    "mobile:install": "npm install --prefix mobile/brah-mobile",
    "mobile:android": "npm run android --prefix mobile/brah-mobile",
    "mobile:dev-client": "npm run android --prefix mobile/brah-mobile",
    "mobile:start": "npm run start --prefix mobile/brah-mobile",
    "check": "biome check .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "update:deps": "ncu -u && npm install",
    "test": "npm run check && node --test",
    "build:mac": "node --env-file-if-exists=.env.local ./node_modules/electron-builder/out/cli/cli.js --config electron-builder.config.cjs --mac dir",
    "open:mac": "npm run build:mac && open dist/mac/Brah.app"
  },
  "keywords": [
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "build": {
    "appId": "com.unstablemind.brah",
    "productName": "Brah",
    "asar": true,
    "npmRebuild": true,
    "asarUnpack": [
      "**/node_modules/@nut-tree-fork/**"
    ],
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dir"
      ],
      "hardenedRuntime": true,
      "identity": "-",
      "gatekeeperAssess": false,
      "timestamp": null,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Brah needs microphone access for realtime voice input.",
        "NSScreenCaptureDescription": "Brah needs screen recording access for screenshots and screen analysis."
      }
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "js-yaml": "^5.2.3",
    "npm-check-updates": "^22.2.1"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "electron-updater": "^6.8.9",
    "playwright": "^1.60.0",
    "qrcode": "^1.5.4",
    "undici": "^8.10.0",
    "ws": "^8.21.0"
  }
}
